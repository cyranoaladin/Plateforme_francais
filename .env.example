# ═══════════ Database ═══════════
DATABASE_URL=postgresql://user:password@localhost:5432/nexus_eaf
DIRECT_URL=postgresql://user:password@localhost:5432/nexus_eaf

# ═══════════ Redis ═══════════
REDIS_URL=redis://localhost:6379

# ═══════════ Auth ═══════════
SESSION_SECRET=minimum_32_characters_random_string_change_in_production
CSRF_SECRET=minimum_32_characters_random_string_change_in_production
CRON_SECRET=minimum_32_characters_random_string_change_in_production
COOKIE_SECURE=false

# ═══════════ Billing ═══════════
# Required in production for activation code HMAC hashing.
# Generate with: openssl rand -hex 32
BILLING_CODE_PEPPER=

# ═══════════ LLM Providers ═══════════
LLM_ROUTER_ENABLED=true
MISTRAL_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:70b
LLM_TIMEOUT_MS=15000
LLM_PROVIDER_ORDER=gemini,openai,mistral,ollama
LLM_MULTI_PROVIDER_FALLBACK=true
LLM_COST_TRACKING=true
LLM_TIER_1_PROVIDER=mistral_reasoning
LLM_TIER_2_PROVIDER=mistral_standard
LLM_TIER_3_PROVIDER=ollama

# ═══════════ RAG ═══════════
RAG_API_URL=http://127.0.0.1:18001
RAG_API_TOKEN=
RAG_TIMEOUT_MS=8000
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=80
RAG_COLLECTION=rag_francais_premiere
RAG_SECTION=education
RAG_MATIERE=Français
RAG_NIVEAU=Première
RAG_GROUPE=Enseignements communs
RAG_TOP_K=10
RAG_RERANK=true
RAG_ALPHA=0.7

# ═══════════ Storage (S3) ═══════════
STORAGE_PROVIDER=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-west-3
AWS_S3_BUCKET=nexus-eaf-copies
S3_ENDPOINT=
S3_PUBLIC_URL=

# ═══════════ Email (SMTP / Hostinger) ═══════════
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=contact@nexusreussite.academy
SMTP_PASS=
EMAIL_FROM=Nexus Réussite <contact@nexusreussite.academy>
EMAIL_REPLY_TO=support@nexusreussite.academy
# Dev uniquement — adresse pour tester les emails
DEV_TEST_EMAIL=

# ═══════════ Payments (ClicToPay) ═══════════
CLICTOPAY_USERNAME=
CLICTOPAY_PASSWORD=
CLICTOPAY_API_BASE_URL=https://ipay.clictopay.com
CLICTOPAY_PUBLIC_BASE_URL=https://eaf.nexusreussite.academy
# CLICTOPAY_CALLBACK_URL=  # auto-computed if not set
# CLICTOPAY_SUCCESS_URL=   # auto-computed if not set
# CLICTOPAY_FAILURE_URL=   # auto-computed if not set
CLICTOPAY_WEBHOOK_SECRET=
CLICTOPAY_IP_ALLOWLIST=

# ═══════════ App ═══════════
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
LOG_LEVEL=info
LOG_PRETTY=true

# ═══════════ MCP Server ═══════════
MCP_SERVER_URL=http://localhost:3100
MCP_API_KEY=change_me_in_production
MCP_TRANSPORT=http

# ═══════════ Tunisia Config ═══════════
# CONFIG_PATH=  # defaults to .antigravity/config_defaults_tunisia_v3_0.json

# ═══════════ Push Notifications ═══════════
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@nexusreussite.academy

# ═══════════ Mistral Models (optional overrides) ═══════════
# MISTRAL_OCR_MODEL=mistral-ocr-latest
# MISTRAL_PIXTRAL_MODEL=pixtral-12b-2409
# MISTRAL_REASONING_MODEL=magistral-medium-latest
# MISTRAL_LARGE_MODEL=mistral-large-latest
# MISTRAL_STANDARD_MODEL=mistral-small-latest
# MISTRAL_MICRO_MODEL=ministral-8b-latest
# MISTRAL_EMBED_MODEL=mistral-embed

# ═══════════ Testing ═══════════
# E2E_USER_EMAIL=jean@eaf.local
# E2E_USER_PASSWORD=demo1234
