# Configuration pour tests E2E
# DB de test Docker sur ports non standards pour éviter les conflits

# Prisma
DATABASE_URL="postgresql://eaf_test:eaf_test_password@localhost:5433/eaf_test?schema=public"
DIRECT_URL="postgresql://eaf_test:eaf_test_password@localhost:5433/eaf_test?schema=public"

# Redis
REDIS_URL="redis://localhost:6380"

# Secrets (valeurs de test uniquement)
SESSION_SECRET="test-session-secret-minimum-32-chars-long-for-e2e-only"
CSRF_SECRET="test-csrf-secret-minimum-32-chars-long-for-e2e-only"
CRON_SECRET="test-cron-secret-minimum-32-chars-long-for-e2e-only"
BILLING_CODE_PEPPER="test-pepper-minimum-32-chars-for-e2e-only"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3110"
APP_ROOT="/tmp/eaf-e2e"
NODE_ENV="production"
E2E_DISABLE_RATE_LIMIT="1"

# LLM (clé factice pour E2E - les appels LLM sont mockés ou échouent gracieusement)
MISTRAL_API_KEY="test-mistral-key-for-e2e-only-not-real"

# Désactiver les services externes pour les tests E2E
LOG_LEVEL="error"
SMTP_HOST=""
SMTP_USER=""
SMTP_PASS=""

# MCP
MCP_SERVER_URL="http://localhost:3100"
MCP_API_KEY="test-mcp-api-key-for-e2e"

# RAG (mode dégradé pour E2E)
RAG_API_URL=""
RAG_API_TOKEN=""
