# ═══════════════════════════════════════════════════════════════
# NEXUS EAF - ENVIRONNEMENT PRODUCTION
# 
# INSTRUCTIONS:
# 1. Copier ce fichier vers /opt/eaf/secrets/.env.production
# 2. Générer les secrets avec les commandes indiquées
# 3. Remplacer les placeholders par vos valeurs réelles
# 4. chmod 600 /opt/eaf/secrets/.env.production
# 5. chown eaf:eaf /opt/eaf/secrets/.env.production
# ═══════════════════════════════════════════════════════════════

# === CORE ===================================================================
NODE_ENV=production
PORT=3000
MCP_PORT=3100
NEXT_PUBLIC_APP_URL=https://eaf.nexusreussite.academy
APP_ROOT=/opt/eaf/current

# === SÉCURITÉ - GÉNÉRER AVEC: openssl rand -base64 32 =======================
SESSION_SECRET=GENERATE_WITH_OPENSSL
CSRF_SECRET=GENERATE_WITH_OPENSSL
CRON_SECRET=GENERATE_WITH_OPENSSL

# === BILLING - GÉNÉRER AVEC: openssl rand -hex 32 ===========================
BILLING_CODE_PEPPER=GENERATE_WITH_OPENSSL

# === MCP - GÉNÉRER AVEC: openssl rand -hex 32 ===============================
MCP_API_KEY=GENERATE_WITH_OPENSSL

# === DATABASE ================================================================
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://eaf_user:STRONG_PASSWORD@localhost:5432/eaf_prod
DIRECT_URL=postgresql://eaf_user:STRONG_PASSWORD@localhost:5432/eaf_prod

# === LLM (au moins un provider obligatoire) ==================================
# Clé Mistral: https://console.mistral.ai/
MISTRAL_API_KEY=your_mistral_api_key_here

# Alternative: clé Gemini (optionnel)
# GEMINI_API_KEY=your_gemini_api_key_here

# Alternative: clé OpenAI (optionnel)
# OPENAI_API_KEY=your_openai_api_key_here

# Configuration LLM
LLM_ROUTER_ENABLED=true
LLM_PROVIDER_ORDER=gemini,openai,mistral
LLM_TIMEOUT_MS=30000
LLM_MULTI_PROVIDER_FALLBACK=true

# === REDIS (recommandé) ======================================================
REDIS_URL=redis://localhost:6379

# === RAG (recommandé) ========================================================
RAG_API_URL=http://127.0.0.1:18001

# === EMAIL (recommandé pour les notifications) ==============================
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587
SMTP_USER=contact@nexusreussite.academy
SMTP_PASS=your_smtp_password_here
EMAIL_FROM=Nexus Réussite <contact@nexusreussite.academy>
EMAIL_REPLY_TO=support@nexusreussite.academy

# === MONITORING ==============================================================
LOG_LEVEL=info

# === STORAGE (optionnel - S3) ===============================================
# STORAGE_PROVIDER=local
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=eu-west-3
# AWS_S3_BUCKET=nexus-eaf-copies

# === ORAL/VOICE (optionnel) =================================================
# ORAL_VOICE_MODE=disabled

# === MÉTADONNÉES DE RELEASE (auto-généré) ===================================
# BUILD_GIT_SHA=
# BUILD_TIME=
