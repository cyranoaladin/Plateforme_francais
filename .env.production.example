# ═══════════════════════════════════════════════════════════════
# NEXUS EAF - ENVIRONNEMENT PRODUCTION (CANONIQUE)
# 
# INSTRUCTIONS:
# 1. Copier ce fichier vers /opt/eaf/secrets/.env.production
# 2. Générer les secrets avec les commandes indiquées ci-dessous
# 3. Remplacer les placeholders par vos valeurs réelles
# 4. chmod 600 /opt/eaf/secrets/.env.production
# 5. chown eaf:eaf /opt/eaf/secrets/.env.production
# 6. Vérifier avec: bash scripts/check-env-production.sh
#
# GÉNÉRATION DES SECRETS INTERNES:
#   SESSION_SECRET=$(openssl rand -base64 32)
#   CSRF_SECRET=$(openssl rand -base64 32)
#   CRON_SECRET=$(openssl rand -base64 32)
#   BILLING_CODE_PEPPER=$(openssl rand -hex 32)
#   MCP_API_KEY=$(openssl rand -hex 32)
#
# CLÉS EXTERNES (à récupérer sur les consoles):
#   - MISTRAL_API_KEY: https://console.mistral.ai/
#   - GEMINI_API_KEY: https://ai.google.dev/ (optionnel)
#   - OPENAI_API_KEY: https://platform.openai.com/ (optionnel)
#   - SMTP_PASS: Fournisseur email
# ═══════════════════════════════════════════════════════════════

# === 🔴 SECTION A: CORE - OBLIGATOIRES ======================================
NODE_ENV=production
PORT=3000
MCP_PORT=3100
NEXT_PUBLIC_APP_URL=https://eaf.nexusreussite.academy
APP_ROOT=/opt/eaf/current

# === 🔴 SECTION B: SÉCURITÉ - OBLIGATOIRES ==================================
# Générer avec: openssl rand -base64 32
SESSION_SECRET=GENERATE_WITH_OPENSSL_RAND_BASE64_32
CSRF_SECRET=GENERATE_WITH_OPENSSL_RAND_BASE64_32
CRON_SECRET=GENERATE_WITH_OPENSSL_RAND_BASE64_32

# Générer avec: openssl rand -hex 32
BILLING_CODE_PEPPER=GENERATE_WITH_OPENSSL_RAND_HEX_32
MCP_API_KEY=GENERATE_WITH_OPENSSL_RAND_HEX_32

# === 🔴 SECTION C: DATABASE - OBLIGATOIRES ==================================
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://eaf_user:STRONG_DB_PASSWORD@localhost:5432/eaf_prod
DIRECT_URL=postgresql://eaf_user:STRONG_DB_PASSWORD@localhost:5432/eaf_prod

# === 🔴 SECTION D: LLM - OBLIGATOIRE (au moins un) ==========================
# Clé Mistral (recommandé): https://console.mistral.ai/
MISTRAL_API_KEY=sk_your_mistral_api_key_here

# Alternative: Clé Gemini (optionnel)
# GEMINI_API_KEY=AI_your_gemini_api_key_here

# Alternative: Clé OpenAI (optionnel)
# OPENAI_API_KEY=sk_your_openai_api_key_here

# Configuration LLM
LLM_ROUTER_ENABLED=true
LLM_PROVIDER_ORDER=gemini,openai,mistral
LLM_TIMEOUT_MS=30000
LLM_MULTI_PROVIDER_FALLBACK=true

# === 🟡 SECTION E: SERVICES - RECOMMANDÉS ===================================
# Redis
REDIS_URL=redis://localhost:6379

# RAG (Recommandé)
RAG_API_URL=http://127.0.0.1:18001
RAG_API_TOKEN=optional_rag_token

# Email SMTP (Recommandé)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587
SMTP_USER=contact@nexusreussite.academy
SMTP_PASS=your_smtp_password_here
EMAIL_FROM=Nexus Réussite <contact@nexusreussite.academy>

# === 🟢 SECTION F: CONFIGURATION OPTIONNELLE ================================
# Logs
LOG_LEVEL=info

# Uploads
MAX_UPLOAD_SIZE_MB=10
CONTACT_EMAIL=contact@nexusreussite.academy
RESSOURCES_ROOT=/srv/eaf_ressources

# MCP
MCP_SERVER_URL=http://localhost:3100

# === 🟢 SECTION G: MISTRAL ADVANCED =========================================
MISTRAL_BASE_URL=https://api.mistral.ai/v1
MISTRAL_REASONING_MODEL=magistral-medium-latest
MISTRAL_LARGE_MODEL=mistral-large-latest
MISTRAL_STANDARD_MODEL=mistral-small-latest
MISTRAL_MICRO_MODEL=ministral-8b-latest
MISTRAL_OCR_MODEL=mistral-ocr-latest
MISTRAL_EMBED_MODEL=mistral-embed

# Budgets (optionnel)
# MISTRAL_DAILY_BUDGET_EUR=5
# MISTRAL_MONTHLY_BUDGET_EUR=100

# === 🟢 SECTION H: RAG ADVANCED =============================================
RAG_TIMEOUT_MS=8000
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=80
RAG_COLLECTION=rag_francais_premiere
RAG_TOP_K=10
RAG_RERANK=true
RAG_ALPHA=0.7

# === 🟢 SECTION I: STORAGE / S3 =============================================
STORAGE_PROVIDER=local
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=eu-west-3
# AWS_S3_BUCKET=nexus-eaf-copies

# === 🟢 SECTION J: ORAL / VOICE =============================================
ORAL_VOICE_MODE=disabled
# OPENAI_STT_MODEL=whisper-1
# OPENAI_TTS_MODEL=tts-1
# OPENAI_TTS_VOICE=alloy

# === 🟢 SECTION K: OLLAMA LOCAL =============================================
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.1:70b
# LLM_FORCE_LOCAL=false

# === 🟢 SECTION L: MONITORING ===============================================
# NEXT_PUBLIC_META_PIXEL_ID=
# META_CAPI_TOKEN=

# === 🟢 SECTION M: WHATSAPP =================================================
NEXT_PUBLIC_WHATSAPP_NUMBER=+21699192829
NEXT_PUBLIC_WHATSAPP_LINK=https://wa.me/21699192829

# === 🟢 SECTION N: PUSH NOTIFICATIONS =======================================
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@nexusreussite.academy

# === 🔵 SECTION O: BUILD METADATA (auto-généré) =============================
# BUILD_GIT_SHA=
# BUILD_TIME=
# HEALTH_CHECK_READY=true
