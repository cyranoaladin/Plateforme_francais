# Configuration minimale pour tests E2E
# En production, ces valeurs sont fournies par les secrets serveur

# Prisma - valeurs factices pour éviter les erreurs de parsing
DATABASE_URL="postgresql://test:test@localhost:5432/eaf_test?schema=public"
DIRECT_URL="postgresql://test:test@localhost:5432/eaf_test?schema=public"

# Session secrets (valeurs de test uniquement)
SESSION_SECRET="test-session-secret-minimum-32-chars-long"
CSRF_SECRET="test-csrf-secret-minimum-32-chars-long"
CRON_SECRET="test-cron-secret-minimum-32-chars-long"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3110"
APP_ROOT="/tmp/eaf-test"

# Désactiver les services externes pour les tests
LOG_LEVEL="error"
