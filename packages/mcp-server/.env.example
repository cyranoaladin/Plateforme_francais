# ============================================================
# MCP Server Nexus Réussite EAF — Variables d'environnement
# Copier ce fichier en .env et remplir les valeurs
# ============================================================

# --- Base de données PostgreSQL (même DB que l'app Next.js) ---
DATABASE_URL=postgresql://eaf_user:eaf_password@localhost:5432/eaf_db

# --- Redis (même instance que BullMQ) ---
REDIS_URL=redis://localhost:6379

# --- Sécurité MCP ---
# Générer avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MCP_API_KEY=nexus_mcp_CHANGEME_32_bytes_hex

# --- Transport ---
# "stdio" pour Claude Desktop / développement
# "http" pour production (PM2)
MCP_TRANSPORT=stdio
MCP_PORT=3100

# Origines autorisées à appeler le serveur (séparées par virgule)
MCP_ALLOWED_ORIGINS=http://localhost:3000,https://eaf.nexusreussite.academy

# --- LLM (pour les outils qui appellent le LLM directement, ex: generate_report) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:70b
OLLAMA_FAST_MODEL=qwen2.5:7b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# --- Logs ---
# "debug" | "info" | "warn" | "error"
MCP_LOG_LEVEL=info
LOG_PRETTY=true

# --- Rate limiting ---
MCP_RATE_LIMIT_PER_MINUTE=100
MCP_RATE_LIMIT_INDEX_PER_HOUR=10

# --- Stockage local (rapports PDF générés) ---
STORAGE_PATH=/var/eaf
REPORTS_DIR=/var/eaf/reports
CORPUS_DIR=/var/eaf/corpus
TEMPLATES_DIR=/var/eaf/templates

# --- Email (pour notifications depuis MCP) ---
RESEND_API_KEY=re_...
EMAIL_FROM=nexus@eaf.nexusreussite.academy
