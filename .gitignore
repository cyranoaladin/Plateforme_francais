# === SECRETS & ENV - NEVER COMMIT ===
.env
.env.local
.env.*.local
.env.backup
.env.*.backup
.release.env
!.env.example
!.env.test

# === MCP SERVER SECRETS ===
packages/mcp-server/.env
!packages/mcp-server/.env.example

# === DEPENDENCIES ===
/node_modules
packages/*/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# === BUILD OUTPUTS ===
/.next
/out
/dist
packages/*/dist
packages/*/build
.next/standalone/.env

# === TESTING ===
/coverage
/test-results
/playwright-report
/blob-report
/playwright/.cache
.vitest-unit-report.json

# === DEBUG ===
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# === LOCAL TOOLS ===
/.idea
/.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
*.swp
*.swo
*~
.DS_Store
*.pem

# === LOGS ===
*.log
logs/

# === UPLOADS & DATA ===
/.data
/data/uploads/*
!/data/uploads/.gitkeep
/data/exports/*
!/data/exports/.gitkeep

# === BACKUPS ===
*.backup
*.bak
*.old
*.orig

# === TEMPORARY FILES ===
*.tmp
*.temp
.cache/

# === FORENSICS & AUDIT ===
/forensics/*
!/forensics/.gitkeep
/.windsurf_audit_logs

# === WORKTREES ===
.worktrees/*

# === PYTHON ===
/.venv
venv/
__pycache__/
*.py[cod]
*$py.class

# === TYPESCRIPT ===
*.tsbuildinfo
next-env.d.ts

# === LOCAL CONFIG ===
.claude/settings.local.json
.antigravity/*.local

# === CI/CD ARTIFACTS ===
/artifacts
/reports

# === MCP LOGS ===
packages/mcp-server/*.log

# === BINARY DOCS (use Markdown instead) ===
*.docx
*.xlsx
*.pptx
